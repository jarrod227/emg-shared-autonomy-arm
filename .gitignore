# ROS 2 generated directories
build/
install/
log/

# Python generated files
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editor and OS files
.vscode/
.idea/
.project
.cproject
.settings/
.DS_Store
.aider*

# Scratch dir from the Codex tool (skills under .codex/ stay tracked)
.codex-tmp/

# Vendor datasheets and reference manuals kept locally for lookup. They are
# copyrighted, large, and freely downloadable; docs/literature_ledger.md
# records the official URL, revision, and the exact quoted claims instead.
docs/*.pdf

# Third-party tools dropped here for local reference (e.g. serialplot). They
# are separately licensed and are not part of this project's source.
docs/serialplot-*/

# Host-test build artifacts. fixture.bin is regenerated by `make check`;
# committing it would let the cross-implementation check pass against a stale
# file instead of against what the C encoder currently produces.
firmware/test/test_emg_packet
firmware/test/test_emg_filter
firmware/test/test_emg_features
firmware/test/test_emg_classifier
firmware/test/test_emg_gate
firmware/test/test_emg_activation
firmware/test/fixture.bin
firmware/test/golden.bin
firmware/test/features.bin
firmware/test/classifier.bin
firmware/test/gate.bin
firmware/test/activation.bin
firmware/test/view.bin

# CubeMX project build output. The generated sources and cheez_emg.ioc are
# tracked -- the .ioc is the authoritative record of the peripheral
# configuration, and the copied HAL keeps the project buildable from a clean
# clone without CubeMX installed.
firmware/cheez_emg/build/
firmware/cheez_emg/.vscode/
compile_commands.json

# One-off calibration aids (not build artifacts of the workspace)
checkerboard_*.png

# Local vendor hardware bundles (manuals, videos, installers, and archives)
docs/SO-ARM101开源6轴机械臂/
docs/单目相机/

# Generated training artifacts, all of them reproducible from what is tracked.
runs/
weights/
*.pt
*.onnx
*.engine

# datasets/ is deliberately NOT ignored. Every number in docs/ is derived from
# those recordings by tools in this repository, so tracking them is what makes
# the claims checkable rather than merely stated. 44 MB across 74 files, the
# largest 2.4 MB, which is comfortably inside GitHub's limits and needs no LFS.
# They contain no paths, usernames, or identifiers -- only samples, labels, and
# calibration summaries.
firmware/test/test_emg_rx

# Claude Code's own state. The installed skills are third-party files fetched
# from elsewhere and the lock records where from, so neither belongs in this
# project's history.
.claude/
skills-lock.json

# Personal planning and career documents, and the AI-assistant working guide.
# They stay on disk because they are used; they are not part of the system this
# repository publishes, and the roadmap in particular is a personal plan rather
# than a description of anything here.
docs/proposal.md
docs/weekly_plan.md
docs/project_context.md
TODO.md
AGENTS.md

# Codex agent working guide, same category as the planning documents above.
.codex/
